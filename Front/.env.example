# DigitalStoreLK — Environment Variables
# Copy this file to .env (locally) and configure your values.
# NEVER commit .env to version control.
#
# For production: configure these in Cloudflare Pages dashboard
# Settings → Environment Variables → Production

# ============================================================
# GitHub Integration (server-side only — Cloudflare Functions)
# ============================================================

# Personal Access Token with repo write access
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub repository owner (username or org)
GITHUB_OWNER=your_github_username_here

# GitHub repository name
GITHUB_REPO=DigitalStoreLK_WEB_Static

# Branch to commit to
GITHUB_BRANCH=main

# ============================================================
# Admin Authentication (server-side only)
# ============================================================

# Plain-text admin password (use a strong password)
# In production, consider bcrypt hashing this value
ADMIN_AUTH_SECRET=DigitalStoreLK@2026

# Random secret for JWT signing (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_random_jwt_secret_minimum_32_characters_here
